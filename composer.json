{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "skyraptor/laravel-versioned-storage",
    "description": "Versioned, safe storage for Laravel.",
    "keywords": [
        "laravel",
        "skyraptor",
        "laravel-versioned-storage"
    ],
    "homepage": "https://github.com/skyraptor/laravel-versioned-storage",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Patrick Henninger",
            "email": "privat@skyraptor.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/concurrency": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/filesystem": "^12.0||^13.0",
        "illuminate/queue": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "league/flysystem-path-prefixing": "^3.0",
        "spatie/fork": "^1.2.12"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "league/flysystem-ftp": "^3.0",
        "league/flysystem-sftp-v3": "^3.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpbench/phpbench": "^1.4",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SkyRaptor\\LaravelVersionedStorage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SkyRaptor\\LaravelVersionedStorage\\Benchmarks\\": "benchmarks/",
            "SkyRaptor\\LaravelVersionedStorage\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "benchmark": [
            "Composer\\Config::disableProcessTimeout",
            "@php benchmarks/compare.php"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pest --mutate --everything --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SkyRaptor\\LaravelVersionedStorage\\VersionedStorageServiceProvider"
            ],
            "aliases": {
                "VersionedStorage": "SkyRaptor\\LaravelVersionedStorage\\Facades\\VersionedStorage"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
